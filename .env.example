# Secret used to sign session JWTs (required in production; any long random string)
AUTH_SECRET=change-me-to-a-long-random-string
# OpenRouter key. Leave empty to run with the built-in mock AI (streams demo answers).
OPENROUTER_API_KEY=
# Optional: SQLite file location (default ./data/campus.db)
DATABASE_PATH=./data/campus.db
# Public URL of the app. Its origin is used for all server redirects (basePath is added automatically),
# and session cookies are marked Secure only when it is https. Also sent to OpenRouter as HTTP-Referer.
APP_URL=http://localhost:3000
